{
  "name": "@telemetry/monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["opentelemetry/backend", "opentelemetry/frontend", "skeletons/*", "packages/*"],
  "scripts": {
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "bun test",
    "dev": "bun --cwd opentelemetry/backend dev & bun --cwd opentelemetry/frontend dev",
    "build": "bun --cwd opentelemetry/backend build && bun --cwd opentelemetry/frontend build",
    "start": "bun --cwd opentelemetry/backend start & bun --cwd opentelemetry/frontend start",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.42.1",
    "typescript": "^5.7.3",
    "vitepress": "^1.5.0"
  }
}
